+	friend bool operator!=(CircuitTableInteger const &a, CircuitTableInteger const &b){return a.v!=b.v;}
 	bool isZero()const{return v.sign()==0;}
 	bool isOne()const{return v==1;}
 	bool isNonZero()const{return v.sign()!=0;}
