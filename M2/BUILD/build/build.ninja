  COMMAND = cd /home/ubuntu/M2/M2/BUILD/build/Macaulay2/packages && /home/ubuntu/M2/M2/BUILD/build/usr-dist/x86_64-Linux-Ubuntu-26.04/bin/M2 -q --stop --silent --no-preload --no-threads -e errorDepth=1 -e debugLevel=0 -e "installPackage(\"Style\", Verbose => false, RerunExamples => false, CheckDocumentation => true, IgnoreExampleErrors => false, RemakeAllDocumentation => false, InstallPrefix => \"/home/ubuntu/M2/M2/BUILD/build/usr-dist/\", UserMode => false, SeparateExec => true, DebuggingMode => true)" -e "\"info-\"|\"Style\" << #Style#\"test inputs\" << close" -e "exit 0" && gzip -nf9 /home/ubuntu/M2/M2/BUILD/build/usr-dist/common/share/info/Style.info
