build Macaulay2/packages/uninstall-Padic: phony Macaulay2/packages/CMakeFiles/uninstall-Padic


#############################################
# Utility command for check-Padic

build Macaulay2/packages/check-Padic: phony Macaulay2/packages/CMakeFiles/check-Padic Macaulay2/m2/M2-core


#############################################
# Utility command for all-Padic

build Macaulay2/packages/all-Padic: phony Macaulay2/packages/CMakeFiles/all-Padic Macaulay2/m2/M2-core


#############################################
# Utility command for package

build Macaulay2/packages/CMakeFiles/package.util: CUSTOM_COMMAND Macaulay2/packages/all
  COMMAND = cd /home/ubuntu/M2/M2/BUILD/build && /usr/bin/cpack --config ./CPackConfig.cmake
  DESC = Run CPack packaging tool...
  pool = console
  restat = 1

build Macaulay2/packages/package: phony Macaulay2/packages/CMakeFiles/package.util


#############################################
# Utility command for package_source

build Macaulay2/packages/CMakeFiles/package_source.util: CUSTOM_COMMAND
  COMMAND = cd /home/ubuntu/M2/M2/BUILD/build && /usr/bin/cpack --config ./CPackSourceConfig.cmake
  DESC = Run CPack packaging tool for source...
  pool = console
  restat = 1

build Macaulay2/packages/package_source: phony Macaulay2/packages/CMakeFiles/package_source.util


#############################################
# Utility command for test

build Macaulay2/packages/CMakeFiles/test.util: CUSTOM_COMMAND
  COMMAND = cd /home/ubuntu/M2/M2/BUILD/build/Macaulay2/packages && /usr/bin/ctest
  DESC = Running tests...
  pool = console
  restat = 1

build Macaulay2/packages/test: phony Macaulay2/packages/CMakeFiles/test.util


#############################################
# Utility command for edit_cache

build Macaulay2/packages/CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/ubuntu/M2/M2/BUILD/build/Macaulay2/packages && /usr/bin/cmake -E echo No\ interactive\ CMake\ dialog\ available.
  DESC = No interactive CMake dialog available...
  restat = 1

build Macaulay2/packages/edit_cache: phony Macaulay2/packages/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build Macaulay2/packages/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /home/ubuntu/M2/M2/BUILD/build/Macaulay2/packages && /usr/bin/cmake --regenerate-during-build -S/home/ubuntu/M2/M2 -B/home/ubuntu/M2/M2/BUILD/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build Macaulay2/packages/rebuild_cache: phony Macaulay2/packages/CMakeFiles/rebuild_cache.util


#############################################
# Utility command for list_install_components

build Macaulay2/packages/list_install_components: phony


#############################################
# Utility command for install

build Macaulay2/packages/CMakeFiles/install.util: CUSTOM_COMMAND Macaulay2/packages/all
  COMMAND = cd /home/ubuntu/M2/M2/BUILD/build/Macaulay2/packages && /usr/bin/cmake -P cmake_install.cmake
  DESC = Install the project...
  pool = console
  restat = 1

build Macaulay2/packages/install: phony Macaulay2/packages/CMakeFiles/install.util


#############################################
# Utility command for install/local

build Macaulay2/packages/CMakeFiles/install/local.util: CUSTOM_COMMAND Macaulay2/packages/all
  COMMAND = cd /home/ubuntu/M2/M2/BUILD/build/Macaulay2/packages && /usr/bin/cmake -DCMAKE_INSTALL_LOCAL_ONLY=1 -P cmake_install.cmake
  DESC = Installing only the local directory...
  pool = console
  restat = 1

build Macaulay2/packages/install/local: phony Macaulay2/packages/CMakeFiles/install/local.util


#############################################
# Utility command for install/strip

build Macaulay2/packages/CMakeFiles/install/strip.util: CUSTOM_COMMAND Macaulay2/packages/all
