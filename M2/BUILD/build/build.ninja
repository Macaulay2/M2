  restat = 1


#############################################
# Phony custom command for Macaulay2/docs/CMakeFiles/M2-docs-sphinx

build Macaulay2/docs/CMakeFiles/M2-docs-sphinx | ${cmake_ninja_workdir}Macaulay2/docs/CMakeFiles/M2-docs-sphinx: phony Macaulay2/docs/index.html


#############################################
# Custom command for Macaulay2/docs/index.html

build Macaulay2/docs/index.html | ${cmake_ninja_workdir}Macaulay2/docs/index.html: CUSTOM_COMMAND /home/ubuntu/M2/M2/Macaulay2/docs/conf.py /home/ubuntu/M2/M2/Macaulay2/docs/index.rst /home/ubuntu/M2/M2/Macaulay2/docs/modules.rst Macaulay2/docs/doxygen/xml/index.xml
  COMMAND = cd /home/ubuntu/M2/M2/BUILD/build/Macaulay2/docs && SPHINX_EXECUTABLE-NOTFOUND -b html -Dbreathe_projects.Macaulay2=/home/ubuntu/M2/M2/BUILD/build/Macaulay2/docs/doxygen/xml /home/ubuntu/M2/M2/Macaulay2/docs /home/ubuntu/M2/M2/BUILD/build/Macaulay2/docs
  DESC = Generating Macaulay2 internal documentation
  pool = console
  restat = 1

