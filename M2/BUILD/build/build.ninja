build Macaulay2/packages/doc-Padic: phony Macaulay2/packages/CMakeFiles/doc-Padic usr-dist/common/share/doc/Macaulay2/Padic/manual.pdf usr-dist/common/share/doc/Macaulay2/Padic/manual.bbl usr-dist/common/share/doc/Macaulay2/Padic/manual.dvi usr-dist/common/share/doc/Macaulay2/Padic/manual.tex usr-dist/common/share/doc/Macaulay2/Padic/manual.aux


#############################################
