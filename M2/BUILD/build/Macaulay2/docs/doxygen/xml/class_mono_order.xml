        <qualifiedname>MonoOrder::MonoOrder</qualifiedname>
        <param>
          <type>const <ref refid="class_mono_order_a07835270a4af74812a8dc33ca525992c_1a07835270a4af74812a8dc33ca525992c" kindref="member">VarIndex</ref></type>
