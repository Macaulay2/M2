</simplesect>
<simplesect kind="see"><para><ref refid="monoid_8h" kindref="compound">interface/monoid.h</ref> </para>
</simplesect>
<simplesect kind="see"><para><ref refid="_new_f4_test_8cpp" kindref="compound">NewF4Test.cpp</ref> </para>
</simplesect>
</para>
