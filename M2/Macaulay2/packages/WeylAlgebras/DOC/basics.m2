--     Key => {setHomSwitch, (setHomSwitch, Boolean), getHomSwitch},
--     Headline => "toggle the use of homogeneous Weyl algebra",
--     Usage => "setHomSwitch n\ngetHomSwitch()",
--     Inputs => { "n" => Boolean => { "new value" } },
--     Outputs => { Boolean => "old value" }
