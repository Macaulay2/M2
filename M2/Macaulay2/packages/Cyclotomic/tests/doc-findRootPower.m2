-- doc-findRootPower.m2
-- findRootPower R, for a polynomial ring over a cyclotomic field or the
-- field itself: the order of the generator of the field, or 2 if the field
-- is QQ (also for the orders 1 and 2).  It is an error if the generator is
-- not a root of unity (e.g. for QQ(sqrt 2)).

assert(findRootPower QQ == 2);
assert(findRootPower(QQ[x]) == 2);
assert(findRootPower(QQ[x, y, z]) == 2);
for n from 1 to 24 do (
    F := cyclotomicField n;
    e := if n <= 2 then 2 else n;
    assert(findRootPower F == e);
    assert(findRootPower(F[x]) == e);
    assert(findRootPower(F[x, y, MonomialOrder => Lex]) == e);
    );
-- odd n: the order of the generator ww_n, not the order 2n of the group
assert(findRootPower cyclotomicField 5 == 5);
assert(findRootPower((cyclotomicField 9)[t]) == 9);
-- fields made by cyclotomicField(N, K)
assert(findRootPower cyclotomicField(4, cyclotomicField 3) == 12);
assert(findRootPower cyclotomicField(6, QQ) == 3);
-- number fields generated by a root of unity, made with toField
assert(findRootPower toField(QQ[a]/(a^2+1)) == 4);
assert(findRootPower((toField(QQ[b]/(b^2+b+1)))[x]) == 3);
assert(findRootPower toField(QQ[c]/(c^4+1)) == 8);
-- the generator is not a root of unity: an error, and the function stops
K = toField(QQ[d]/(d^2-2));
assert(try (findRootPower K; false) else true);
assert(try (findRootPower(K[x, y]); false) else true);
K = toField(QQ[e]/(e^3-2));
assert(try (findRootPower(K[x]); false) else true);
K = toField(QQ[f]/(f^2-f-1));
assert(try (findRootPower K; false) else true);
-- Q(i) generated by 1 + i: not a root of unity
K = toField(QQ[g]/(g^2-2*g+2));
assert(try (findRootPower K; false) else true);
