-- doc-joinCyclotomic.m2 -- independent tests from the documentation alone.
-- joinCyclotomic l: ideals in polynomial rings with the same variables over
-- QQ and cyclotomic fields, or over finite fields of one characteristic, go
-- to one polynomial ring over the cyclotomic field whose order is the lcm
-- of the orders, or over the Galois field whose degree is the lcm of the
-- degrees.  The common ring has the monoid of the ring of the first ideal
-- and is made once for every such ring and field.  Version 1.0 forgot the
-- degrees and the monomial order, made a new ring on every call, and mapped
-- rings with different variables by position; now that is an error.

fieldDeg = K -> if instance(K, GaloisField) then K.degree else 1;
primeDivs = m -> apply(toList factor m, f -> f#0);
hasOrder = (x, m) -> (x != 0 and x^m == 1 and all(primeDivs m, r -> x^(m // r) != 1));
-- the ideals of the result are the images of the input ideals
checkImages = (l, L) -> (
    assert(instance(L, List) and #L == #l);
    T := ring L#0;
    for J in L do assert(ring J === T);
    for i from 0 to #l-1 do (
        phi := cyclotomicInclusion(ring l#i, T);
        assert(L#i == phi l#i));
    T);

-- the documented example
F3 = cyclotomicField 3; F4 = cyclotomicField 4;
R = F3[t]; I = ideal(t - F3_0^2);
S = F4[t]; J = ideal(t^2 - F4_0);
L = joinCyclotomic {I, J};
T = checkImages({I, J}, L);
assert(coefficientRing T === cyclotomicField 12);
z = (cyclotomicField 12)_0;
assert(L#0 == ideal(T_0 + z^2) and L#1 == ideal(T_0^2 - z^3));
-- made once: the same ring on every call, also for other ideals in these rings
assert(ring first joinCyclotomic {I, J} === T);
assert(ring first joinCyclotomic {ideal(R_0^3 - 1), ideal(S_0 + F4_0)} === T);
-- the order of the input does not change the field
assert(coefficientRing ring first joinCyclotomic {J, I} === cyclotomicField 12);

-- QQ and cyclotomic fields: the field has the lcm of the orders
fieldPairs = {(0, 3), (0, 4), (3, 5), (4, 6), (5, 10), (8, 12), (3, 3), (0, 0), (7, 0)};
for p in fieldPairs do (
    A := if p#0 == 0 then QQ else cyclotomicField p#0;
    B := if p#1 == 0 then QQ else cyclotomicField p#1;
    R1 := A[x, y]; R2 := B[x, y];
    a := if A === QQ then 1_A else A_0;
    b := if B === QQ then 1_B else B_0;
    l := {ideal(R1_0 - a, R1_1^2 + a*R1_0), ideal(R2_0*R2_1 - b, R2_1^3)};
    L := joinCyclotomic l;
    T := checkImages(l, L);
    K := coefficientRing T;
    -- K contains both fields: the lcm of the orders of the generators
    n := lcm(findRootPower A, findRootPower B);
    assert(K === QQ or hasOrder(cyclotomicRoot(K, 1/n), n));
    assert(ring first joinCyclotomic l === T);
    );

-- the monoid of the first ring: variables, degrees, monomial order
R = F3[x, y, Degrees => {2, 3}, MonomialOrder => Lex];
S = F4[x, y];
l = {ideal(R_0^3 - R_1^2), ideal(S_0 - S_1)};
L = joinCyclotomic l;
T = checkImages(l, L);
assert(degrees T == {{2}, {3}});
assert((options T).MonomialOrder === (options R).MonomialOrder);
assert(apply(gens T, toString) == {"x", "y"});
assert(isHomogeneous L#0);
assert(leadTerm(T_0 + T_1^5) == T_0);
assert(ring first joinCyclotomic l === T);
R = QQ[x, y, z, MonomialOrder => {Weights => {3, 2, 1}}];
S = F4[x, y, z];
L = joinCyclotomic {ideal(R_0 + R_2^2), ideal(S_1)};
T = ring L#0;
assert((options T).MonomialOrder === (options R).MonomialOrder);
assert(leadTerm(T_0 + T_2^2) == T_0);

-- different variables: an error, not a map by position
R = F3[x, y]; S = F4[x, z];
assert(try (joinCyclotomic {ideal(R_0), ideal(S_1)}; false) else true);
R = F3[x]; S = F4[x, y];
assert(try (joinCyclotomic {ideal(R_0), ideal(S_1)}; false) else true);
R = F3[u, v]; S = QQ[x, y];
assert(try (joinCyclotomic {ideal(R_0), ideal(S_1)}; false) else true);
-- the same variables in another order: no map by position
R = F3[x, y]; S = F4[y, x];
r = try joinCyclotomic {ideal(R_0), ideal(S_0)} else null;
if r =!= null then (
    T = ring r#0;
    -- the ideal (y) of S must stay the ideal generated by the variable named y
    assert(r#1 == ideal((gens T)#(position(gens T, v -> toString v == "y")))));

-- finite fields of one characteristic: the lcm of the degrees
K4 = GF 4; K8 = GF 8; K9 = GF 9; K25 = GF 25; K125 = GF 125;
N9 = GF(ZZ/3[c]/(c^2+1));
cases = {(ZZ/5, K25), (K25, K125), (ZZ/5, ZZ/5), (K4, K8), (ZZ/2, K8),
    (K9, ZZ/3), (N9, ZZ/3), (N9, N9), (cyclotomicField(3, ZZ/5), K125),
    -- two rings for one field: Macaulay2's GF 25 and the one of cyclotomicField,
    -- GF 9 from the Conway polynomial and from c^2 + 1
    (K25, cyclotomicField(3, ZZ/5)), (cyclotomicField(3, ZZ/5), K25),
    (K9, N9), (N9, K9), (N9, GF 27)};
for p in cases do (
    A := p#0; B := p#1;
    R1 := A[x, y]; R2 := B[x, y];
    l := {ideal(R1_0 - A_0, R1_1^2 - R1_0), ideal(R2_0 + R2_1 + B_0^2)};
    L := joinCyclotomic l;
    T := checkImages(l, L);
    K := coefficientRing T;
    d := lcm(fieldDeg A, fieldDeg B);
    assert(char K == char A and fieldDeg K == d);
    assert(ring first joinCyclotomic l === T);
    );
-- a single ideal
R = F3[x, y]; I = ideal(R_0^2 + F3_0);
L = joinCyclotomic {I};
assert(#L == 1);
T = checkImages({I}, L);
