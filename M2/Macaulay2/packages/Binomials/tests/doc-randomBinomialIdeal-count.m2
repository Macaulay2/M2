-- doc-randomBinomialIdeal-count.m2
-- randomBinomialIdeal(R, n, d, w, h) returns at most n generators.
-- Documented: an ideal "generated by n random differences of monomials";
-- Caveat: "Minimal generators of the ideal are returned.  There can be fewer
-- than n of them".
-- Cases (setRandomSeed 17, R = QQ[a..x]): (6,2,4,true) (the documented
-- example), (3,4,10,false), (1,1,2,true), (5,3,3,false), (10,1,24,true).
-- Expected: at most n generators.

R = QQ[a..x];
for args in {(6,2,4,true), (3,4,10,false), (1,1,2,true), (5,3,3,false), (10,1,24,true)} do (
    (n, d, w, h) := args;
    setRandomSeed 17;
    I := randomBinomialIdeal(R, n, d, w, h);
    assert(numgens I <= n));
