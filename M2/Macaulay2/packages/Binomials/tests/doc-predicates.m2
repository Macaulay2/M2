-- doc-predicates.m2
-- isBinomial, isUnital, isCellular (with and without ReturnCellVars).
-- Oracles:
--  * isBinomial: an ideal is binomial iff its reduced Groebner basis (any term
--    order) consists of binomials and monomials [ES96, Cor. 1.2].
--  * isUnital: generated by monomials and differences of monomials, i.e. the
--    reduced Groebner basis consists of monomials and x^a - x^b.
--  * isCellular: every variable is a non-zerodivisor (I : v^oo == I) or
--    nilpotent (v in rad I); ReturnCellVars gives exactly the non-zerodivisors.
-- Inputs include non-binomial generators of binomial ideals, redundant
-- generators, non-standard term orders and gradings.

-- ---------------------------------------------------------------------------
-- Oracle helpers (independent of the package; only Macaulay2 core is used).
-- Results may live in K[x] with K = QQ[ww]/(Phi) a cyclotomic field.  Since
-- K[x] = QQ[x,ww]/(Phi), ideals of K[x] correspond to ideals of QQ[x,ww]
-- containing Phi, and primality, primariness, associated primes, minimal
-- primes, intersections and containments are preserved under this
-- correspondence.  liftData S returns (phi, Phi) with phi: S -> QQ[x,ww]
-- sending a normal form to a representative; liftIdeal adds Phi back.
liftData = S -> (
    g := generators(S, CoefficientRing => QQ);
    T := QQ[Variables => #g];
    phi := map(T, S, gens T);
    rel := ideal(0_T);
    R0 := S;
    while R0 =!= QQ do (
        if instance(R0, QuotientRing) then (
            A0 := ambient R0;
            gA := generators(A0, CoefficientRing => QQ);
            rel = rel + (map(T, A0, take(gens T, -#gA))) ideal R0;
            R0 = A0)
        else R0 = coefficientRing R0);
    (phi, rel))
liftIdeal = (J, D) -> (D#0) J + D#1
-- equality of two lists of ideals as sets
setEq = (A, B) -> all(A, a -> any(B, b -> a == b)) and all(B, b -> any(A, a -> a == b))
-- cellular variables / nilpotent variables by definition
nzdVars = I -> select(gens ring I, v -> saturate(I, v) == I)
nilVars = I -> (r := radical I; select(gens ring I, v -> isSubset(ideal v, r)))
isCellularOracle = I -> (#nzdVars I + #nilVars I == numgens ring I)
-- ---------------------------------------------------------------------------

gbIsBinomial = I -> all(flatten entries gens gb I, f -> #terms f <= 2);
gbIsUnital = I -> all(flatten entries gens gb I, f -> (
        #terms f == 1 or (#terms f == 2 and set apply(terms f, t -> leadCoefficient t) === set {1_(coefficientRing ring I), -1_(coefficientRing ring I)})));

checkPredicates = I -> (
    assert(isBinomial I === gbIsBinomial I);
    if gbIsBinomial I then assert(isUnital I === gbIsUnital I);
    );

rings = {QQ[x,y,z], QQ[x,y,z, MonomialOrder=>Lex], QQ[x,y,z, Weights=>{1,2,3}],
         QQ[x,y,z, Degrees=>{1,2,3}], QQ[x,y,z, MonomialOrder=>{Weights=>{3,1,2}, GRevLex}]};
for R in rings do (
    x := R_0; y := R_1; z := R_2;
    ideals := {
        ideal(x^2), ideal(x-y+z, z), ideal(x^3-x), ideal(x-z, z-y), ideal(x+z), ideal(x^2),
        ideal(x+y+z), ideal(x*y+x*z+y*z), ideal(x^2+2*x*y+y^2), ideal(x^2-2*y^2), ideal(2*x-3*y),
        -- binomial ideals given by non-binomial generators
        ideal(x^2-y^2, x^2+y^2-2*z^2),          -- = (x^2-y^2, y^2-z^2), unital
        ideal(x-y+z^2, z^2),                    -- = (x-y, z^2), unital
        ideal(x+y+z, y+z),                      -- = (x, y+z), binomial, not unital
        ideal(x*y-z^2+x^2, x^2),                -- = (x*y-z^2, x^2), unital
        ideal(x^2+y^2+z^2, x^2-y^2),            -- = (x^2-y^2, 2*y^2+z^2): binomial, not unital
        ideal(x+y+z, x-y),                      -- = (x-y, 2x+z): binomial, not unital
        ideal(x+y+z, x^2-y^2),                  -- not binomial
        ideal(x*y*z-1, x^2-y, x*y-1, x^3-1),    -- redundant generators
        ideal(0_R), ideal(1_R), ideal(x,y,z), ideal(3*x-3*y)};
    scan(ideals, checkPredicates);
    -- explicit expectations
    assert(isBinomial ideal(x+y+z) === false);
    assert(isBinomial ideal(x^2-y^2, x^2+y^2-2*z^2) === true);
    assert(isUnital ideal(x^2-y^2, x^2+y^2-2*z^2) === true);
    assert(isUnital ideal(x-y+z^2, z^2) === true);
    assert(isBinomial ideal(x+y+z, y+z) === true);
    assert(isUnital ideal(x+y+z, y+z) === false);
    assert(isUnital ideal(x^2-2*y^2) === false);
    assert(isUnital ideal(2*x-3*y) === false);
    assert(isUnital ideal(3*x-3*y) === true);
    assert(isBinomial ideal(x+y+z, x^2-y^2) === false);
    );

-- isCellular against the definition
R = QQ[x,y,z,w];
cellIdeals = {
    ideal(x-z^2, y^4), ideal(x*y-z, x*z-y^2), ideal(y^3, y^2*z^2-x^3, x*y^2*z, x^3*z-x*y),
    ideal(x^2, x*y), ideal(x^2, x*(y-1)), ideal(x*(y^3-1), x^2), ideal(x^2-1, y-x),
    ideal(x*y-z*w), ideal(x*y-z*w, x^2), ideal(x^2, y^2, z^2, w^2), ideal(x*(y-1)),
    ideal(x^2-y^2, z^3), ideal(x^3-y^2, z*w), ideal(x^2-2*y^2, z^2), ideal(2*x-3*y, z*w-w),
    ideal(x*y, z*w), ideal(x^2*y-z^2*w, x*w^3), ideal(0_R), ideal(x,y,z,w), ideal(x-y, z-w, x^2)};
for I in cellIdeals do (
    c := isCellular I;
    assert(c === isCellularOracle I);
    cv := isCellular(I, ReturnCellVars=>true);
    if c then (
        assert(instance(cv, List));
        assert(set cv === set nzdVars I))
    else assert(cv === false);
    );
assert(isCellular ideal(x*y, z*w) === false);
assert(isCellular ideal(x*(y-1)) === false);
assert(isCellular ideal(x^2, x*(y-1)) === true);
assert(set isCellular(ideal(x^2, x*(y-1)), ReturnCellVars=>true) === set {y,z,w});
assert(set isCellular(ideal(0_R), ReturnCellVars=>true) === set gens R);
assert(isCellular(ideal(x,y,z,w), ReturnCellVars=>true) == {});

-- non-standard grading and order for isCellular
for R in {QQ[x,y,z, Degrees=>{2,3,1}], QQ[x,y,z, MonomialOrder=>Lex], QQ[x,y,z,Degrees=>{{1,0},{0,1},{1,1}}]} do (
    x := R_0; y := R_1; z := R_2;
    for I in {ideal(x^3-y^2, z^2), ideal(x*z-y*z, z^2), ideal(x*(y-1), x^2), ideal(x*y, x-y)} do (
        assert(isCellular I === isCellularOracle I);
        if isCellularOracle I then assert(set isCellular(I, ReturnCellVars=>true) === set nzdVars I)));
