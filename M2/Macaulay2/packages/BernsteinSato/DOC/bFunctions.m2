doc ///
  Key
    bFunction
  Headline
    Bernstein-Sato polynomial of a $D$-module with respect to a weight
  Description
    Text
      See [@TO2 ("WeylAlgebras :: Works Cited", "OT01")@, Section 4].
    Text
      @UL {
	  {TO (bFunction, Ideal,List), " -- for an ideal"},
	  {TO (bFunction, Module,List,List), " -- for a module"}
	  }@
///

