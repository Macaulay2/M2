--- old format (commented out) ---
-- document {
--      Key => {(globalBoperator, RingElement), globalBoperator},
--      Headline => "compute a b-operator of a polynomial",
--      SeeAlso => {"globalB"}
--      }

doc ///
  Key
    (globalBoperator, RingElement)
    globalBoperator
  Headline
    compute a $b$-operator of a polynomial
  Usage
    globalBoperator f
  Inputs
    f:RingElement
      a polynomial in a Weyl algebra (no differential variables)
  Outputs
    :RingElement
      the $b$-operator $P$ satisfying $P f^{s+1} = b(s) f^s$
  Description
    Text
      Convenience wrapper around @TO globalB@ that returns just the
      @TT "Boperator"@ component — the differential operator $P$ in the
      Bernstein functional equation.
    Example
      R = QQ[x, dx, WeylAlgebra => {x=>dx}]
      globalBoperator(x^3)
  SeeAlso
    globalB
    globalBFunction
///

--- old format (commented out) ---
-- document {
--      Key => {(localBFunction,RingElement,Ideal), localBFunction},
--      Headline => "local b-function (a.k.a. the local Bernstein-Sato polynomial)",
--      Usage => "b = localBFunction(f,P)",
--      Inputs => {
-- 	  "f" => {"a polynomial"},
-- 	  "P" => {"a (prime) ideal"}
-- 	  },
--      Outputs => {
-- 	  "b" => RingElement => {"the local b-function ", EM "b_P(s)",  " in ", EM "Q[s]"}
-- 	  },
--      PARA {
-- 	  "Computes the local b-function of f at P, if P is a prime ideal."
-- 	  },
--      Caveat => {"(feature) If P is not prime, computes the
-- 	  lcm of local b-functions over all primes containing P"},
--      	  EXAMPLE lines ///
-- 	  R = QQ[x,y]; f = x^2*(x+y+1); P = ideal(x,y);
--     	  b = localBFunction(f,P)
-- 	  factorBFunction b
--      	  ///,
--      SeeAlso => { "bFunction", "factorBFunction", "globalBFunction", "generalB", "globalB" }
--      }

doc ///
  Key
    (localBFunction, RingElement, Ideal)
    localBFunction
  Headline
    local $b$-function (a.k.a. the local Bernstein-Sato polynomial)
  Usage
    b = localBFunction(f, P)
  Inputs
    f:RingElement
      a polynomial
    P:Ideal
      a (prime) ideal
  Outputs
    b:RingElement
      the local $b$-function $b_P(s)$ in $\QQ[s]$
  Description
    Text
      Computes the local $b$-function of $f$ at $P$, if $P$ is a prime ideal.
    Example
      R = QQ[x,y]; f = x^2*(x+y+1); P = ideal(x,y);
      b = localBFunction(f,P)
      factorBFunction b
  Caveat
    If $P$ is not prime, computes the lcm of local $b$-functions over all primes containing $P$.
  SeeAlso
    bFunction
    factorBFunction
    globalBFunction
    generalB
    globalB
///

