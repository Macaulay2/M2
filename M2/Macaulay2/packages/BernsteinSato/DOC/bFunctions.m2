-- 	  }
--      }

doc ///
  Key
    IntRing
    [bFunction, Strategy]
    NonGeneric
    TryGeneric
  Headline
    specify strategy for computing $b$-function
  Description
    Text
      @UL {
	  {TT "IntRing", TEX " -- the simplest algorithm available.
	       The idea is to compute $in_{(-w,w)}(I)$,
	       intersect it with
	       $k[t_1,\\ldots,t_n]$ ($t_i = x_i D_i$).
	       Call the ideal obtained $J$.
	       Finally $J + (t_1 + \\ldots + t_n - s) \\cap k[s]$
	       is generated by the $b$-function that we are looking for."
	       },
	  {TT "TryGeneric", " -- checks whether the ideal is generic
	       and if that is the case uses Algorithm 5.1.5
	       in [", TO2 ("WeylAlgebras :: Works Cited", "SST00"), "] otherwise is equivalent
	       to ", TT "NonGeneric"
	       },
	  {TT "NonGeneric",
	       " -- uses 5.1.6 in [", TO2 ("WeylAlgebras :: Works Cited", "SST00"), "]"
	       },
	  {"Default: ", TT "IntRing"}
	  }@
///


